<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Customer.master.cs" Inherits="Customer_Customer" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>Civil Registry - Citizen Portal</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="../css/style.css" rel="stylesheet" />
    <asp:ContentPlaceHolder id="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
    
    <!-- Customer Header -->
    <header class="civic-header">
        <div class="civic-header-inner">
            <div class="civic-logo-box">
                <asp:Image ID="Image1" runat="server" Height="55px" 
                    ImageUrl="~/Image/TAHIR (1).jpg" Width="220px" style="object-fit: contain; border-radius: 6px; background: #ffffff; padding: 4px;" />
                <div>
                    <h1 class="civic-title">Citizen Service Portal</h1>
                    <p class="civic-subtitle">Apply, Track &amp; Download Official Certificates</p>
                </div>
            </div>
            <div class="civic-auth-links">
                <div style="background: rgba(255,255,255,0.15); padding: 8px 16px; border-radius: 6px; font-weight: 600; color: #ffffff;">
                    Welcome, <asp:Label ID="Label1" runat="server" style="color: #f59e0b; font-weight: 700;"></asp:Label>
                </div>
            </div>
        </div>
    </header>

    <!-- Customer Navigation Bar -->
    <div class="civic-nav-bar">
        <div class="civic-nav-container">
            <asp:Menu ID="Menu1" runat="server" Orientation="Horizontal" 
                RenderingMode="Table" Width="100%" ForeColor="White">
                <StaticMenuItemStyle HorizontalPadding="20px" VerticalPadding="14px" ForeColor="White" Font-Bold="true" />
                <StaticHoverStyle BackColor="#1d4ed8" ForeColor="White" />
                <DynamicMenuItemStyle BackColor="#0b1f33" ForeColor="White" HorizontalPadding="18px" VerticalPadding="12px" Font-Bold="true" />
                <DynamicHoverStyle BackColor="#1d4ed8" ForeColor="White" />
                <DynamicMenuStyle BackColor="#0b1f33" />
                <Items>
                    <asp:MenuItem NavigateUrl="~/User/home.aspx" Text="Home" Value="Home">
                    </asp:MenuItem>
                    <asp:MenuItem Text="Edit Profile" 
                        Value="Edit Profile" NavigateUrl="~/Customer/EditProfile.aspx"></asp:MenuItem>
                    <asp:MenuItem Text="Certificate Application" Value="Certificate">
                        <asp:MenuItem NavigateUrl="~/Customer/AadharCard.aspx" Text="Aadhar Card" 
                            Value="Aadhar Card"></asp:MenuItem>
                        <asp:MenuItem NavigateUrl="~/Customer/birthcertificate.aspx" 
                            Text="Birth Certificate" Value="Birth certificate"></asp:MenuItem>
                        <asp:MenuItem NavigateUrl="~/Customer/DeathCertificate.aspx" 
                            Text="Death Certificate" Value="Death Certificate"></asp:MenuItem>
                        <asp:MenuItem NavigateUrl="~/Customer/MarriageCertificate.aspx" 
                            Text="Marriage Certificate" Value="Marriage Certificate"></asp:MenuItem>
                        <asp:MenuItem Text="PAN Card" Value="Pan Card" 
                            NavigateUrl="~/Customer/PanCard.aspx"></asp:MenuItem>
                        <asp:MenuItem Text="Voter ID" Value="Voter Id" 
                            NavigateUrl="~/Customer/VoterIdCard.aspx"></asp:MenuItem>
                    </asp:MenuItem>
                    <asp:MenuItem Text="Feedback" Value="Feedback" 
                        NavigateUrl="~/Customer/Feedback.aspx"></asp:MenuItem>
                    <asp:MenuItem Text="Reports &amp; Certificates" 
                        Value="Report">
                        <asp:MenuItem Text="Aadhaar Card Report" Value="Aadhaar Card" 
                            NavigateUrl="~/Customer/AadharReport.aspx"></asp:MenuItem>
                        <asp:MenuItem NavigateUrl="~/Customer/PancardReport.aspx" Text="PAN Card Report" 
                            Value="PanCard"></asp:MenuItem>
                        <asp:MenuItem Text="Voter ID Report" Value="VoterId Card" 
                            NavigateUrl="~/Customer/VoterIdReport.aspx"></asp:MenuItem>
                        <asp:MenuItem Text="Birth Certificate Report" Value="Birth Certificate" 
                            NavigateUrl="~/Customer/BirthReport.aspx"></asp:MenuItem>
                        <asp:MenuItem NavigateUrl="~/Customer/MarriageRepot.aspx" 
                            Text="Marriage Certificate Report" Value="Marriage Certificate"></asp:MenuItem>
                        <asp:MenuItem Text="Death Certificate Report" Value="Death Certificate" 
                            NavigateUrl="~/Customer/DeathReport.aspx"></asp:MenuItem>
                    </asp:MenuItem>
                    <asp:MenuItem Text="Logout" Value="Logout" NavigateUrl="~/User/home.aspx">
                    </asp:MenuItem>
                </Items>
            </asp:Menu>
        </div>
    </div>

    <!-- Main Content Area -->
    <main class="page-container">
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        </asp:ContentPlaceHolder>
    </main>

    <!-- Footer -->
    <footer class="civic-footer">
        <p><strong>Civil Registry Management System</strong> &bull; Official Citizen Portal</p>
        <p style="font-size: 0.82rem; opacity: 0.8;">PROJECT BY MUSKAN &amp; TAHIR</p>
    </footer>

    </form>
</body>
</html>
