<%@ Master Language="C#" AutoEventWireup="true" CodeFile="User.master.cs" Inherits="User_User" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>Civil Registry Management System</title>
    <meta http-equiv="content-type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <link rel="stylesheet" type="text/css" href="../engine1/style.css" />
    <script type="text/javascript" src="../engine1/jquery.js"></script>
    <link href="../css/style.css" rel="stylesheet" />
    
    <asp:ContentPlaceHolder id="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
    
    <!-- Modern Header -->
    <header class="civic-header">
        <div class="civic-header-inner">
            <div class="civic-logo-box">
                <asp:Image ID="Image5" runat="server" Height="60px" 
                    ImageUrl="~/Image/TAHIR (1).jpg" Width="240px" style="object-fit: contain; border-radius: 6px; background: #ffffff; padding: 4px;" />
                <div>
                    <h1 class="civic-title">Civil Registry Portal</h1>
                    <p class="civic-subtitle">Government Document &amp; Registration Services</p>
                </div>
            </div>
            <div class="civic-auth-links">
                <asp:Image ID="Image4" runat="server" Height="24px" 
                    ImageUrl="~/Image/usericon.png" style="vertical-align: middle;" />
                <asp:HyperLink ID="HyperLink1" runat="server" CssClass="civic-auth-link" 
                    NavigateUrl="~/User/Customerlogin.aspx">Sign In</asp:HyperLink>
                <span style="color: #94a3b8; font-weight: bold;">/</span>
                <asp:HyperLink ID="HyperLink2" runat="server" CssClass="civic-auth-link" 
                    NavigateUrl="~/user/Registrationform.aspx">Sign Up</asp:HyperLink>
            </div>
        </div>
    </header>

    <!-- Navigation Bar -->
    <div class="civic-nav-bar">
        <div class="civic-nav-container">
            <asp:Menu ID="Menu1" runat="server" ForeColor="White" 
                Orientation="Horizontal" RenderingMode="Table" 
                style="text-align: center; width: 100%;">
                <StaticMenuItemStyle HorizontalPadding="20px" VerticalPadding="14px" ForeColor="White" Font-Bold="true" />
                <StaticHoverStyle BackColor="#1d4ed8" ForeColor="White" />
                <DynamicMenuItemStyle BackColor="#0b1f33" ForeColor="White" HorizontalPadding="18px" VerticalPadding="12px" Font-Bold="true" />
                <DynamicHoverStyle BackColor="#1d4ed8" ForeColor="White" />
                <DynamicMenuStyle BackColor="#0b1f33" />
                <Items>
                    <asp:MenuItem NavigateUrl="~/User/Home.aspx" Text="Home" Value="Home">
                    </asp:MenuItem>
                    <asp:MenuItem NavigateUrl="~/User/aboutus.aspx" Text="About Us" 
                        Value="About Us"></asp:MenuItem>
                    <asp:MenuItem Text="Forms" Value="Forms">
                        <asp:MenuItem NavigateUrl="~/User/Registrationofbirth.aspx" 
                            Text="Birth Certificate" Value="birth Certificate"></asp:MenuItem>
                        <asp:MenuItem NavigateUrl="~/User/Registrationdeath.aspx" 
                            Text="Death Certificate" Value="Death Certificate"></asp:MenuItem>
                        <asp:MenuItem NavigateUrl="~/User/Marriagecertificate.aspx" 
                            Text="Marriage Certificate" Value="Marriage Certificate"></asp:MenuItem>
                        <asp:MenuItem NavigateUrl="~/User/Panregestration.aspx" Text="Pan Card" 
                            Value="Pan Card"></asp:MenuItem>
                        <asp:MenuItem NavigateUrl="~/User/Adharcardregestration.aspx" 
                            Text="Aadhar Card" Value="Aadhar Card"></asp:MenuItem>
                        <asp:MenuItem NavigateUrl="~/User/Voteridcard.aspx" Text="Voter ID" 
                            Value="Voter ID"></asp:MenuItem>
                    </asp:MenuItem>
                    <asp:MenuItem NavigateUrl="~/user/enquiry.aspx" Text="Contact" Value="Contact">
                    </asp:MenuItem>
                </Items>
            </asp:Menu>
        </div>
    </div>

    <!-- Main Content Container -->
    <main class="page-container">
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        </asp:ContentPlaceHolder>
    </main>

    <!-- Modern Footer -->
    <footer class="civic-footer">
        <p><strong>Civil Registry Management System</strong> &bull; Official Citizen Portal</p>
        <p style="font-size: 0.82rem; opacity: 0.8;">PROJECT BY MUSKAN &amp; TAHIR</p>
    </footer>

    </form>
</body>
</html>
