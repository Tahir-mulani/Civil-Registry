<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Admin.master.cs" Inherits="Admin_Admin" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">
    <title>Civil Registry - Admin Portal</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="../css/style.css" rel="stylesheet" />
    <asp:ContentPlaceHolder id="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
    
    <!-- Admin Header -->
    <header class="civic-header">
        <div class="civic-header-inner">
            <div class="civic-logo-box">
                <div>
                    <h1 class="civic-title" style="color: #ffffff;">CIVIL REGISTRATION ADMIN</h1>
                    <p class="civic-subtitle">Administrative Control Panel & Application Management</p>
                </div>
            </div>
            <div class="civic-auth-links">
                <asp:HyperLink ID="HyperLink13" runat="server" CssClass="civic-auth-link" 
                    NavigateUrl="~/User/home.aspx">Logout</asp:HyperLink>
            </div>
        </div>
    </header>

    <!-- Admin Wrapper with Sidebar & Content -->
    <div class="admin-wrapper">
        <!-- Sidebar Navigation -->
        <aside class="admin-sidebar">
            <div class="admin-sidebar-header">
                <h3>Navigation Menu</h3>
            </div>
            <ul class="admin-menu-list">
                <li class="admin-menu-item">
                    <asp:HyperLink ID="HyperLink1" runat="server" CssClass="admin-menu-link" 
                        NavigateUrl="~/Admin/Home.aspx">Home Page</asp:HyperLink>
                </li>
                <li class="admin-menu-item">
                    <asp:HyperLink ID="HyperLink2" runat="server" CssClass="admin-menu-link" 
                        NavigateUrl="~/Admin/Manage_Forms.aspx">Manage Forms</asp:HyperLink>
                </li>
                <li class="admin-menu-item">
                    <asp:HyperLink ID="HyperLink3" runat="server" CssClass="admin-menu-link" 
                        NavigateUrl="~/Admin/Adhaarapprove.aspx">
                        <asp:Image ID="Image1" runat="server" Height="24px" ImageUrl="~/Image/adhar.png" Width="30px" style="vertical-align: middle;" />
                        Adhaar Approval
                    </asp:HyperLink>
                </li>
                <li class="admin-menu-item">
                    <asp:HyperLink ID="HyperLink4" runat="server" CssClass="admin-menu-link" 
                        NavigateUrl="~/Admin/Birthapprove.aspx">
                        <asp:Image ID="Image2" runat="server" Height="24px" ImageUrl="~/Image/Birth_Certificate.png" Width="30px" style="vertical-align: middle;" />
                        Birth Approval
                    </asp:HyperLink>
                </li>
                <li class="admin-menu-item">
                    <asp:HyperLink ID="HyperLink5" runat="server" CssClass="admin-menu-link" 
                        NavigateUrl="~/Admin/Deathapprove.aspx">
                        <asp:Image ID="Image3" runat="server" Height="24px" ImageUrl="~/Image/death.jpg" Width="30px" style="vertical-align: middle;" />
                        Death Approval
                    </asp:HyperLink>
                </li>
                <li class="admin-menu-item">
                    <asp:HyperLink ID="HyperLink6" runat="server" CssClass="admin-menu-link" 
                        NavigateUrl="~/Admin/Marriageapprove.aspx">
                        <asp:Image ID="Image4" runat="server" Height="24px" ImageUrl="~/Image/marr.png" Width="30px" style="vertical-align: middle;" />
                        Marriage Approval
                    </asp:HyperLink>
                </li>
                <li class="admin-menu-item">
                    <asp:HyperLink ID="HyperLink7" runat="server" CssClass="admin-menu-link" 
                        NavigateUrl="~/Admin/Pancardapprove.aspx">
                        <asp:Image ID="Image5" runat="server" Height="24px" ImageUrl="~/Image/PAN-Card-for-a-Minor-Everything-You-Need-To-Know-thumbnail.png" Width="30px" style="vertical-align: middle;" />
                        PAN Card Approval
                    </asp:HyperLink>
                </li>
                <li class="admin-menu-item">
                    <asp:HyperLink ID="HyperLink8" runat="server" CssClass="admin-menu-link" 
                        NavigateUrl="~/Admin/VoterIdapprove.aspx">
                        <asp:Image ID="Image6" runat="server" Height="24px" ImageUrl="~/Image/voter id.png" Width="30px" style="vertical-align: middle;" />
                        Voter Card Approval
                    </asp:HyperLink>
                </li>
                <li class="admin-menu-item">
                    <asp:HyperLink ID="HyperLink9" runat="server" CssClass="admin-menu-link" 
                        NavigateUrl="~/Admin/Manage_Customer.aspx">
                        <asp:Image ID="Image7" runat="server" Height="24px" ImageUrl="~/Image/pan2.png" Width="30px" style="vertical-align: middle;" />
                        Manage Customers
                    </asp:HyperLink>
                </li>
                <li class="admin-menu-item">
                    <asp:HyperLink ID="HyperLink10" runat="server" CssClass="admin-menu-link" 
                        NavigateUrl="~/Admin/View_Feedback.aspx">
                        <asp:Image ID="Image8" runat="server" Height="24px" ImageUrl="~/Image/pan2.png" Width="30px" style="vertical-align: middle;" />
                        View Feedback
                    </asp:HyperLink>
                </li>
                <li class="admin-menu-item">
                    <asp:HyperLink ID="HyperLink11" runat="server" CssClass="admin-menu-link" 
                        NavigateUrl="~/Admin/Manage_admin.aspx">
                        <asp:Image ID="Image9" runat="server" Height="24px" ImageUrl="~/Image/pan2.png" Width="30px" style="vertical-align: middle;" />
                        Manage Admins
                    </asp:HyperLink>
                </li>
                <li class="admin-menu-item">
                    <asp:HyperLink ID="HyperLink12" runat="server" CssClass="admin-menu-link" 
                        NavigateUrl="~/admin Report/AadharCard.aspx">
                        <asp:Image ID="Image10" runat="server" Height="24px" ImageUrl="~/Image/pan2.png" Width="30px" style="vertical-align: middle;" />
                        Reports Portal
                    </asp:HyperLink>
                </li>
            </ul>
        </aside>

        <!-- Main Admin Content -->
        <main class="admin-content">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                <asp:Panel ID="Panel1" runat="server" 
                    BackImageUrl="~/Image/HD_Technologies_Banner5.jpg" Height="400px" 
                    style="border-radius: 12px; background-size: cover; background-position: center;">
                </asp:Panel>
            </asp:ContentPlaceHolder>
        </main>
    </div>

    <!-- Hidden image reference to ensure Image11 control exists if code behind checks it -->
    <asp:Image ID="Image11" runat="server" Visible="false" ImageUrl="~/Image/pan2.png" />

    <!-- Modern Footer -->
    <footer class="civic-footer">
        <p><strong>Civil Registry Management System</strong> &bull; Administrative Panel</p>
        <p style="font-size: 0.82rem; opacity: 0.8;">PROJECT BY MUSKAN &amp; TAHIR</p>
    </footer>
    
    </form>
</body>
</html>